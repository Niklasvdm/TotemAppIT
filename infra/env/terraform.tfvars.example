# =============================================================================
# terraform.tfvars.example — Totem Finder dev/test LXC
#
# Copy to infra/env/dev.tfvars and fill in real values. dev.tfvars is gitignored.
# This box is disposable: destroy + re-apply whenever you want a clean slate.
# =============================================================================

# Proxmox connection
proxmox_host_ip     = "192.168.10.55"       # API URL derived automatically
pm_api_token_id     = "root@pam!Terraform"  # user@realm!token-name
pm_api_token_secret = "your-token-secret-here"
pm_tls_insecure     = true

# Container
target_node   = "pve"
vmid          = 210                          # bump for a second parallel box
hostname      = "totem-dev"
ostemplate    = "local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst"
root_password = "change-me"

# SSH (public key injected; private key must be in your ssh-agent)
ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
ssh_private_key_path = "~/.ssh/id_ed25519"

# Resources (lean defaults — bump cores/memory only if the Phase-3 Vite build drags)
cores          = 1
memory         = 1024
swap           = 512
rootfs_storage = "local"
rootfs_size    = "8G"

# Network
bridge           = "vmbr0"
container_ip     = "192.168.10.7"
container_prefix = "24"
ip_address       = "192.168.10.7/24"
gateway          = "192.168.10.1"
ssh_host         = ""

# Toolchain
go_version = "1.26.8"   # ncruces/go-sqlite3 requires Go >= 1.26
node_major = "22"
timezone   = "Europe/Brussels"
